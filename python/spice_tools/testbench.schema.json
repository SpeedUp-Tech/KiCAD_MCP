{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://kicad-mcp.local/testbench.schema.json",
    "title": "KiCAD MCP SPICE testbench schema",
    "type": "object",
    "description": "Strict schema for autogenerated SPICE testbenches. Reading sections remain, simulation sections are validated for CI and downstream extraction.",
    "required": [
        "version",
        "module",
        "interfaces",
        "use_cases"
    ],
    "additionalProperties": false,
    "properties": {
        "version": {
            "type": "string",
            "minLength": 1,
            "description": "Semantic version of the testbench format."
        },
        "module": {
            "type": "string",
            "minLength": 1,
            "description": "Logical design name; informative."
        },
        "assumptions": {
            "type": "array",
            "description": "Human-readable context only; ignored by runner.",
            "items": {
                "type": "string"
            }
        },
        "gaps": {
            "type": "array",
            "description": "Known omissions; informative only.",
            "items": {
                "type": "object",
                "properties": {
                    "spec_id": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    },
                    "suggest_use_case": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        },
        "interfaces": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "inputs",
                "outputs"
            ],
            "properties": {
                "inputs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "outputs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "corners": {
            "type": "object",
            "description": "Optional sweep definitions; used only if supported by runner.",
            "additionalProperties": false,
            "properties": {
                "vin_V": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "load_A": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "temp_C": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "tolerances": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "R_pct": {
                            "type": "number"
                        },
                        "C_pct": {
                            "type": "number"
                        },
                        "L_pct": {
                            "type": "number"
                        },
                        "mlcc_dc_bias_pct": {
                            "type": "number"
                        }
                    }
                }
            }
        },
        "use_cases": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/use_case"
            }
        }
    },
    "definitions": {
        "node_ref": {
            "type": "string",
            "minLength": 1
        },
        "branch_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_+\\-\\.]+->[A-Za-z0-9_+\\-\\.]+$",
            "description": "Branch notation start->end"
        },
        "quantity": {
            "description": "Numeric value, optionally with engineering suffix and unit (e.g. 1e-3, \"50mV\", \"1mA\").",
            "oneOf": [
                {
                    "type": "number"
                },
                {
                    "type": "string",
                    "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?:p|n|u|m|k|meg|g)?(?:A|V|s|ms)?$"
                }
            ]
        },
        "time_window": {
            "description": "Either [start_ms, end_ms] or a single duration in ms (interpreted as [0, duration]).",
            "oneOf": [
                {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "type": "number"
                    }
                },
                {
                    "type": "number"
                }
            ]
        },
        "vin_cfg": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
                {
                    "required": [
                        "dc_V"
                    ]
                },
                {
                    "required": [
                        "ramp"
                    ]
                },
                {
                    "required": [
                        "step"
                    ]
                },
                {
                    "required": [
                        "ac_ripple_pp_V"
                    ]
                }
            ],
            "properties": {
                "dc_V": {
                    "type": "number"
                },
                "ramp": {
                    "type": "object",
                    "required": [
                        "start_V",
                        "stop_V",
                        "rise_ms"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "start_V": {
                            "type": "number"
                        },
                        "stop_V": {
                            "type": "number"
                        },
                        "rise_ms": {
                            "type": "number"
                        },
                        "delay_ms": {
                            "type": "number",
                            "default": 0
                        }
                    }
                },
                "step": {
                    "type": "object",
                    "required": [
                        "from_V",
                        "to_V",
                        "at_ms"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "from_V": {
                            "type": "number"
                        },
                        "to_V": {
                            "type": "number"
                        },
                        "at_ms": {
                            "type": "number"
                        }
                    }
                },
                "ac_ripple_pp_V": {
                    "type": "number"
                },
                "ac_freq_kHz": {
                    "type": "number"
                }
            }
        },
        "load_cfg": {
            "type": "object",
            "oneOf": [
                {
                    "required": [
                        "type",
                        "I_A"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "const": "const_current"
                        },
                        "I_A": {
                            "type": "number"
                        }
                    }
                },
                {
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "const": "battery_model"
                        },
                        "voc_V": {
                            "type": "number"
                        },
                        "esr_ohm": {
                            "type": "number"
                        },
                        "capacity_Ah": {
                            "type": "number"
                        }
                    }
                }
            ]
        },
        "sim_cfg": {
            "type": "object",
            "description": "Optional simulation controls to override/limit heuristics.",
            "additionalProperties": false,
            "properties": {
                "end_ms": {
                    "type": "number",
                    "description": "Explicit simulation end time in ms."
                },
                "min_end_ms": {
                    "type": "number",
                    "description": "Minimum allowed end time in ms for heuristic."
                },
                "max_end_ms": {
                    "type": "number",
                    "description": "Maximum allowed end time in ms for heuristic."
                },
                "target_points": {
                    "type": "integer",
                    "minimum": 2,
                    "description": "Target number of time samples over [0, end_ms]."
                },
                "min_points": {
                    "type": "integer",
                    "minimum": 2,
                    "description": "Minimum number of time samples over [0, end_ms]."
                },
                "max_points": {
                    "type": "integer",
                    "minimum": 2,
                    "description": "Maximum number of time samples over [0, end_ms]."
                },
                "min_step_s": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Lower bound on time step in seconds."
                },
                "max_step_s": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Upper bound on time step in seconds."
                }
            }
        },
        "when_cfg": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "observe_window_ms": {
                    "$ref": "#/definitions/time_window"
                },
                "stabilize_ms": {
                    "type": "number"
                },
                "apply_load_at_ms": {
                    "type": "number"
                }
            }
        },
        "assertion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "<=": {
                    "$ref": "#/definitions/quantity"
                },
                ">=": {
                    "$ref": "#/definitions/quantity"
                }
            },
            "oneOf": [
                {
                    "required": [
                        "<="
                    ]
                },
                {
                    "required": [
                        ">="
                    ]
                }
            ]
        },
        "measurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "fn",
                "args",
                "assert"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "fn": {
                    "type": "string",
                    "enum": [
                        "mean",
                        "efficiency",
                        "overshoot_pp",
                        "undershoot_pp",
                        "ripple_pp",
                        "sample_at",
                        "settling_time",
                        "time_to_cross",
                        "in_band_time"
                    ]
                },
                "args": {
                    "type": "object"
                },
                "assert": {
                    "$ref": "#/definitions/assertion"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "mean"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/mean_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "efficiency"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/efficiency_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "overshoot_pp"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/overshoot_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "undershoot_pp"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/undershoot_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "ripple_pp"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/ripple_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "sample_at"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/sample_at_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "settling_time"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/settling_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "time_to_cross"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/time_to_cross_args"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "fn": {
                                "const": "in_band_time"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "args": {
                                "$ref": "#/definitions/in_band_args"
                            }
                        }
                    }
                }
            ]
        },
        "mean_args": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "node_diff": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                        "$ref": "#/definitions/node_ref"
                    }
                },
                "branch": {
                    "$ref": "#/definitions/branch_ref"
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            },
            "anyOf": [
                {
                    "required": [
                        "node"
                    ]
                },
                {
                    "required": [
                        "node_diff"
                    ]
                },
                {
                    "required": [
                        "branch"
                    ]
                }
            ]
        },
        "efficiency_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "input_node",
                "output_node",
                "I_out_A"
            ],
            "properties": {
                "input_node": {
                    "$ref": "#/definitions/node_ref"
                },
                "output_node": {
                    "$ref": "#/definitions/node_ref"
                },
                "I_out_A": {
                    "type": "number"
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            }
        },
        "overshoot_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "node",
                "target_V",
                "window_ms"
            ],
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "target_V": {
                    "type": "number"
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            }
        },
        "undershoot_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "node",
                "target_V",
                "window_ms"
            ],
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "target_V": {
                    "type": "number"
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            }
        },
        "ripple_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "node",
                "window_ms"
            ],
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            }
        },
        "sample_at_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "node",
                "at_ms"
            ],
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "at_ms": {
                    "type": "number"
                }
            }
        },
        "settling_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "window_ms"
            ],
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "branch": {
                    "$ref": "#/definitions/branch_ref"
                },
                "target_V": {
                    "type": "number"
                },
                "target_A": {
                    "type": "number"
                },
                "band_pct": {
                    "type": "number",
                    "minimum": 0
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            },
            "anyOf": [
                {
                    "required": [
                        "node",
                        "target_V"
                    ]
                },
                {
                    "required": [
                        "branch",
                        "target_A"
                    ]
                }
            ]
        },
        "time_to_cross_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "node",
                "level_V",
                "direction",
                "window_ms"
            ],
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "level_V": {
                    "type": "number"
                },
                "direction": {
                    "type": "string",
                    "enum": [
                        "rising",
                        "falling"
                    ]
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            }
        },
        "in_band_args": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "node",
                "lo_V",
                "hi_V",
                "window_ms"
            ],
            "properties": {
                "node": {
                    "$ref": "#/definitions/node_ref"
                },
                "lo_V": {
                    "type": "number"
                },
                "hi_V": {
                    "type": "number"
                },
                "window_ms": {
                    "$ref": "#/definitions/time_window"
                }
            }
        },
        "use_case": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "mode",
                "given",
                "then"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "complex"
                    ],
                    "description": "auto = fully machine-checkable with built-ins; complex = requires hook"
                },
                "given": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "VIN",
                        "load"
                    ],
                    "properties": {
                        "VIN": {
                            "$ref": "#/definitions/vin_cfg"
                        },
                        "load": {
                            "$ref": "#/definitions/load_cfg"
                        },
                        "env": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "source_impedance_mohm": {
                                    "type": "number"
                                },
                                "pack_esr_mohm": {
                                    "type": "number"
                                },
                                "wiring_inductance_nH": {
                                    "type": "number"
                                }
                            }
                        },
                        "ambient": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "temp_C": {
                                    "type": "number"
                                }
                            }
                        },
                        "faults": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "initial_battery_voc_V": {
                                    "type": "number"
                                },
                                "short_to_gnd_at_ms": {
                                    "type": "number"
                                },
                                "short_res_ohm": {
                                    "type": "number"
                                }
                            }
                        }
                    }
                },
                "when": {
                    "$ref": "#/definitions/when_cfg"
                },
                "sim": {
                    "$ref": "#/definitions/sim_cfg"
                },
                "then": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "measurements"
                    ],
                    "properties": {
                        "measurements": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "$ref": "#/definitions/measurement"
                            }
                        },
                        "trace_to_spec": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "hook": {
                    "type": "string",
                    "description": "Optional module:function for complex post-processing."
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "auto"
                            }
                        }
                    },
                    "then": {
                        "not": {
                            "required": [
                                "hook"
                            ]
                        }
                    }
                }
            ]
        }
    }
}
